-- OPTIMIZACIÓN LOCAL Y REVERSIBLE
local Lighting = game:GetService("Lighting")

local originalLighting = {
    GlobalShadows = Lighting.GlobalShadows,
}

local originalEffects = {}
local originalParts = {}

local function RememberAndDisable(instance, property, cache)
    if cache[instance] == nil then
        local ok, value = pcall(function()
            return instance[property]
        end)

        if ok then
            cache[instance] = value
        end
    end

    pcall(function()
        instance[property] = false
    end)
end

local function ApplyPerformanceSettings()
    local boost = Settings.FPSBooster or Settings.PerformanceMode
    local antiLag = Settings.AntiLag or Settings.PerformanceMode
    local lowGraphics = Settings.LowGraphics or Settings.PerformanceMode
    local enabled = boost or antiLag or lowGraphics

    if enabled then
        if boost or lowGraphics then
            Lighting.GlobalShadows = false
        end

        for _, object in ipairs(game:GetDescendants()) do
            if antiLag or lowGraphics then
                if object:IsA("ParticleEmitter")
                or object:IsA("Trail")
                or object:IsA("Beam")
                or object:IsA("Smoke")
                or object:IsA("Fire")
                or object:IsA("Sparkles") then
                    RememberAndDisable(object, "Enabled", originalEffects)
                elseif object:IsA("PostEffect") then
                    RememberAndDisable(object, "Enabled", originalEffects)
                end
            end

            if boost or lowGraphics then
                if object:IsA("BasePart") then
                    RememberAndDisable(object, "CastShadow", originalParts)
                end
            end
        end
    else
        Lighting.GlobalShadows = originalLighting.GlobalShadows

        for instance, oldValue in pairs(originalEffects) do
            if instance and instance.Parent then
                pcall(function()
                    instance.Enabled = oldValue
                end)
            end
        end

        table.clear(originalEffects)

        for instance, oldValue in pairs(originalParts) do
            if instance and instance.Parent then
                pcall(function()
                    instance.CastShadow = oldValue
                end)
            end
        end

        table.clear(originalParts)
    end
end

