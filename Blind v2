end

local function Toggle(parent, title, initial, callback)
    local active = initial

    local button = Create("TextButton", {
        Size = UDim2.new(1, -4, 0, 38),
        BackgroundColor3 = ButtonColor,
        TextColor3 = White,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, parent)

    Corner(button, 7)

    local function Refresh()
        button.Text = "   " .. title .. "       " ..
            (active and "ON" or "OFF")

        button.BackgroundColor3 =
            active and Color3.fromRGB(35, 91, 135)
            or ButtonColor
    end

    Refresh()

    button.Activated:Connect(function()
        active = not active
        Refresh()
        callback(active)
    end)
end

local function Slider(parent, title, minimum, maximum, initial, callback)
    local holder = Create("Frame", {
        Size = UDim2.new(1, -4, 0, 60),
        BackgroundColor3 = Color3.fromRGB(27, 36, 54),
    }, parent)

    Corner(holder, 7)

    local label = Create("TextLabel", {
        Position = UDim2.fromOffset(10, 4),
        Size = UDim2.new(1, -20, 0, 22),
        BackgroundTransparency = 1,
        TextColor3 = White,
        Font = Enum.Font.GothamSemibold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    local bar = Create("TextButton", {
        Position = UDim2.new(0, 10, 0, 35),
        Size = UDim2.new(1, -20, 0, 10),
        BackgroundColor3 = Color3.fromRGB(65, 76, 96),
        Text = "",
        AutoButtonColor = false,
    }, holder)

    Corner(bar, 6)

    local fill = Create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Accent,
        BorderSizePixel = 0,
    }, bar)

    Corner(fill, 6)

    local knob = Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = White,
    }, bar)

    Corner(knob, 10)

    local dragging = false

    local function SetValue(value)
        value = math.clamp(
            math.floor(value + 0.5),
            minimum,
            maximum
        )

        local alpha = (value - minimum) / (maximum - minimum)

        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        label.Text = title .. ": " .. value

        callback(value)
    end

    local function Update(x)
        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0,
            1
        )

        SetValue(minimum + alpha * (maximum - minimum))
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            Update(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            Update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    SetValue(initial)
end
