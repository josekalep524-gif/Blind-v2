-- ACTUALIZAR ESP DE CADA JUGADOR

local function UpdatePlayerESP(target)
    if target == Player then return end

    local character = target.Character

    if not character then
        RemoveVisuals(target)
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not head or not root or humanoid.Health <= 0 then
        RemoveVisuals(target)
        return
    end

    local data = Visuals[target]

    if not data then
        data = {}
        Visuals[target] = data
    end

    -- CABEZA GRANDE
    if Settings.BigEnemyHead then
        if data.Head ~= head then
            data.Head = head
            data.OriginalHeadSize = head.Size
        end

        if data.OriginalHeadSize then
            head.Size = data.OriginalHeadSize * 5
        end
    elseif data.Head and data.OriginalHeadSize then
        if data.Head.Parent then
            data.Head.Size = data.OriginalHeadSize
        end

        data.Head = nil
        data.OriginalHeadSize = nil
    end

    -- HIGHLIGHT
    if Settings.Highlight then
        if not data.Highlight or data.Highlight.Parent ~= character then
            if data.Highlight then
                data.Highlight:Destroy()
            end

            local highlight = Instance.new("Highlight")
            highlight.Name = "BlindHighlight"
            highlight.Adornee = character
            highlight.FillColor = Accent
            highlight.OutlineColor = White
            highlight.FillTransparency = 0.78
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.Parent = character

            data.Highlight = highlight
        end
    elseif data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end

    -- BILLBOARD
    local needsBillboard =
        Settings.NameESP
        or Settings.HealthESP
        or Settings.WeaponESP

    if not needsBillboard then
        if data.Billboard then
            data.Billboard:Destroy()
            data.Billboard = nil
        end

        return
    end

    if not data.Billboard or data.Billboard.Parent ~= root then
        if data.Billboard then
            data.Billboard:Destroy()
        end

        data.Billboard = CreatePlayerBillboard(target, root)
        data.Billboard.Size = UDim2.fromOffset(190, 150)
    end

    local billboard = data.Billboard

    local info = billboard:FindFirstChild("Info")
    local weaponImage = billboard:FindFirstChild("WeaponImage")
    local weaponText = billboard:FindFirstChild("WeaponText")

    -- BARRA DE VIDA
    local healthBackground = billboard:FindFirstChild("HealthBackground")
    local healthFill = billboard:FindFirstChild("HealthFill")

    if not healthBackground then
        healthBackground = Create("Frame", {
            Name = "HealthBackground",
            Position = UDim2.new(0.15, 0, 0, 30),
            Size = UDim2.new(0.7, 0, 0, 8),
            BackgroundColor3 = Color3.fromRGB(55, 55, 65),
            BorderSizePixel = 0,
            Visible = false,
        }, billboard)

        Corner(healthBackground, 5)

        healthFill = Create("Frame", {
            Name = "HealthFill",
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(50, 220, 90),
            BorderSizePixel = 0,
        }, healthBackground)

        Corner(healthFill, 5)
    end

    -- NOMBRE
    if Settings.NameESP then
        info.Text = target.DisplayName
        info.Visible = true
    else
        info.Text = ""
        info.Visible = false
    end

    -- VIDA
    if Settings.HealthESP then
        local percentage = math.clamp(
            humanoid.Health / math.max(humanoid.MaxHealth, 1),
            0,
            1
        )

        healthBackground.Visible = true

        healthFill.Size = UDim2.new(percentage, 0, 1, 0)

        if percentage > 0.6 then
            healthFill.BackgroundColor3 = Color3.fromRGB(50, 220, 90)
        elseif percentage > 0.3 then
            healthFill.BackgroundColor3 = Color3.fromRGB(255, 190, 45)
        else
            healthFill.BackgroundColor3 = Color3.fromRGB(240, 65, 65)
        end
    else
        healthBackground.Visible = false
    end

    -- IMAGEN DEL ARMA
    if Settings.WeaponESP then
        local tool = GetEquippedTool(character)

        if tool then
            local imageId = GetToolImage(tool)

            if imageId ~= "" then
                weaponImage.Image = imageId

                local imageSize = Settings.WeaponImageSize

                weaponImage.Size = UDim2.fromOffset(
                    imageSize,
                    imageSize * 0.74
                )

                weaponImage.Position = UDim2.new(0.5, 0, 0, 45)
                weaponImage.Visible = true
                weaponText.Visible = false
            else
                weaponImage.Visible = false

                weaponText.Position = UDim2.new(0.5, 0, 0, 45)
                weaponText.Text = tool.Name .. "\n(sin imagen)"
                weaponText.Visible = true
            end
        else
            weaponImage.Visible = false
            weaponText.Text = "Sin arma equipada"
            weaponText.Visible = true
        end
    else
        weaponImage.Visible = false
        weaponText.Visible = false
    end
end

-- TRACERS

local function GetTracer(target)
    if Tracers[target] and Tracers[target].Parent then
        return Tracers[target]
    end

    local line = Instance.new("Frame")
    line.Name = "Tracer_" .. target.Name
    line.AnchorPoint = Vector2.new(0, 0.5)
    line.Size = UDim2.fromOffset(0, 2)
    line.BackgroundColor3 = Accent
    line.BorderSizePixel = 0
    line.Visible = false
    line.Parent = TracerLayer

    Tracers[target] = line

    return line
end

local function UpdateTracer(target, fromPosition, toPosition)
    local line = GetTracer(target)

    local difference = toPosition - fromPosition
    local distance = difference.Magnitude

    line.Position = UDim2.fromOffset(
        fromPosition.X,
        fromPosition.Y
    )

    line.Size = UDim2.fromOffset(distance, 2)

    line.Rotation = math.deg(
        math.atan2(difference.Y, difference.X)
    )

    line.BackgroundColor3 = Accent
    line.Visible = true
end

local function HideTracer(target)
    if Tracers[target] then
        Tracers[target].Visible = false
    end
end

-- BUSCAR OBJETIVO DENTRO DEL FOV Y DE LA DISTANCIA ELEGIDA
-- EL OBJETIVO ES LA CABEZA; SE ELIGE EL JUGADOR VÁLIDO MÁS CERCANO

local function GetAimTarget(camera, center)
    local myCharacter = Player.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    if not myRoot then
        return nil
    end

    local selectedHead = nil
    local shortestWorldDistance = Settings.AimStudsRange

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player then
            local character = target.Character

            if character then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local head = character:FindFirstChild("Head")
                local root = character:FindFirstChild("HumanoidRootPart")

                if humanoid and head and root and humanoid.Health > 0 then
                    local worldDistance = (root.Position - myRoot.Position).Magnitude
                    local screenPosition, onScreen = camera:WorldToViewportPoint(head.Position)

                    if onScreen and screenPosition.Z > 0 then
                        local screenPoint = Vector2.new(screenPosition.X, screenPosition.Y)
                        local fovDistance = (screenPoint - center).Magnitude

                        if fovDistance <= Settings.FOV
                        and worldDistance <= Settings.AimStudsRange
                        and worldDistance < shortestWorldDistance then
                            shortestWorldDistance = worldDistance
                            selectedHead = head
                        end
                    end
                end
            end
        end
    end

    return selectedHead
end

-- ACTUALIZACIÓN PRINCIPAL

local updateTimer = 0

RunService.Heartbeat:Connect(function(deltaTime)
    local character = Player.Character

    if character then
        local humanoid =
            character:FindFirstChildOfClass("Humanoid")

        if humanoid then
            humanoid.WalkSpeed = Settings.WalkSpeed
        end
    end

    -- NOCLIP
    if Settings.Noclip and character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if OriginalCollision[part] == nil then
                    OriginalCollision[part] = part.CanCollide
                end

                part.CanCollide = false
            end
        end
    elseif next(OriginalCollision) ~= nil then
        for part, oldValue in pairs(OriginalCollision) do
            if part and part.Parent then
                part.CanCollide = oldValue
            end
        end

        table.clear(OriginalCollision)
    end

    -- ACTUALIZAR ESP
    updateTimer += deltaTime

    if updateTimer >= 0.2 then
        updateTimer = 0

        for _, target in ipairs(Players:GetPlayers()) do
            if target ~= Player then
                UpdatePlayerESP(target)
            end
        end
    end
end)

-- CÁMARA, FOV Y TRACERS

RunService.RenderStepped:Connect(function()
    local camera = workspace.CurrentCamera

    if not camera then return end

    local viewport = camera.ViewportSize

    local center = Vector2.new(
        viewport.X / 2,
        viewport.Y / 2
    )

    -- CÍRCULO FOV
    FOVCircle.Position = UDim2.fromOffset(
        center.X,
        center.Y
    )

    FOVCircle.Size = UDim2.fromOffset(
        Settings.FOV * 2,
        Settings.FOV * 2
    )

    FOVStroke.Color = Accent

    -- ORIGEN DEL TRACER
    local myCharacter = Player.Character

    local myHead = myCharacter
        and myCharacter:FindFirstChild("Head")

    local myRoot = myCharacter
        and myCharacter:FindFirstChild("HumanoidRootPart")

    local originPart = myHead or myRoot
    local originScreen = center

    if originPart then
        local screen, visible =
            camera:WorldToViewportPoint(originPart.Position)

        if visible and screen.Z > 0 then
            originScreen = Vector2.new(
                screen.X,
                screen.Y
            )
        end
    end

    -- TRACERS
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player then
            local character = target.Character

            local head = character
                and character:FindFirstChild("Head")

            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")

            if Settings.Tracer and head
            and humanoid and humanoid.Health > 0 then

                local screen, visible =
                    camera:WorldToViewportPoint(head.Position)

                local point = Vector2.new(
                    screen.X,
                    screen.Y
                )

                local distance = (point - center).Magnitude

                if visible and screen.Z > 0
                and distance <= Settings.FOV then

                    UpdateTracer(
                        target,
                        originScreen,
                        point
                    )
                else
                    HideTracer(target)
                end
            else
                HideTracer(target)
            end
        end
    end

    -- AIM ASSIST
    if Settings.AimAssist then
        local targetHead = GetAimTarget(camera, center)

        if targetHead then
            local desiredCamera = CFrame.lookAt(
                camera.CFrame.Position,
                targetHead.Position
            )

            camera.CFrame = camera.CFrame:Lerp(
                desiredCamera,
                math.clamp(Settings.AimStrength, 0, 1)
            )
        end
    end
end)

