local Visuals = {}
local Tracers = {}

local function RemoveVisuals(target)
    local data = Visuals[target]

    if data then
        if data.Head and data.OriginalHeadSize and data.Head.Parent then
            data.Head.Size = data.OriginalHeadSize
        end

        for _, object in pairs(data) do
            if typeof(object) == "Instance" and object.Parent then
                object:Destroy()
            end
        end
    end

    Visuals[target] = nil

    if Tracers[target] then
        Tracers[target]:Destroy()
        Tracers[target] = nil
    end
end

local function GetEquippedTool(character)
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            return item
        end
    end

    return nil
end

local function GetToolImage(tool)
    if not tool then return "" end

    if tool.TextureId and tool.TextureId ~= "" then
        return tool.TextureId
    end

    for _, object in ipairs(tool:GetDescendants()) do
        if object:IsA("Decal") or object:IsA("Texture") then
            if object.Texture ~= "" then
                return object.Texture
            end
        elseif object:IsA("SpecialMesh") then
            if object.TextureId ~= "" then
                return object.TextureId
            end
        end
    end

    return ""
end

